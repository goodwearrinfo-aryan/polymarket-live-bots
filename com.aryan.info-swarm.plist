<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aryan.info-swarm</string>
    <key>ProgramArguments</key>
    <array>
        <!-- framework python: has TCC/disk access to ~/Documents (launchd /bin/bash + stock python do not) -->
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/aryanagarwal/Documents/polymarket/swarm.py</string>
        <string>--scheduled</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aryanagarwal/Documents/polymarket</string>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <!-- logs OFF ~/Documents (the exit-78 TCC trap) -->
    <key>StandardOutPath</key>
    <string>/tmp/info-swarm.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/info-swarm.err</string>
</dict>
</plist>
